# Dependencies and build output
node_modules/
dist/
build/
.react-router/
coverage/

# Secrets. .env.example carries every key with safe values — copy it to .env.
.env
.env.*
!.env.example

# Build-tooling artifacts. This app was generated by a code-generation pipeline that
# keeps its specs, prompts, run reports and logs alongside the source. None of it is
# part of the application: the backend's seed data now lives in
# backend/src/database/fixtures/, and nothing else here is read at runtime.
.claude-project/
.claude-project.hidden/
.claude-rules
CLAUDE.md
HANDOFF.md
.run-ports.jsonl

# Vercel CLI scratch: link metadata and build output, per-machine.
.vercel/

# Test and QA artifacts. All regenerable: the Playwright suites rewrite them on
# each run, and storageState-*.json carries a REAL authenticated session cookie.
test-results/
playwright-report/
**/tests/storageState-*.json
*.log

# Build-machine scratch: the pipeline's scope-lock keeps a second copy of each page
# here to detect an LLM node overwriting a scaffolded file. Duplicated source.
**/.scaffold-snapshots/

# OS
.DS_Store
