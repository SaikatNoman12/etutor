# Copy to .env and fill in. Never commit .env.

DEV=
VITE_API_URL=http://localhost:3900/api
VITE_APP_NAME=E-Tutor
VITE_DEFAULT_LOCALE=en

# Where a 401 sends the visitor. This app's sign-in screen is /admin/login — the default
# ('/login') is a guess that would land on the 404 page. See app/utils/errorHandler.ts.
VITE_LOGIN_PATH=/admin/login
