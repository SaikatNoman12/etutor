# Copy to .env and fill in. Never commit .env.
#
# These are the keys the app actually reads (env-config.service.ts). The values below
# are the local-development defaults used while building this app; the only one that
# MUST change outside local dev is AUTH_JWT_SECRET.

PORT=3900
MODE=DEV

# Postgres — the local docker container (see README "Database").
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=etutor

# Auth. Generate a real secret for anything that is not local dev:
#   openssl rand -base64 32
AUTH_JWT_SECRET=replace-me-with-a-32-char-or-longer-random-secret
AUTH_TOKEN_COOKIE_NAME=access_token
AUTH_TOKEN_EXPIRE_TIME=86400
AUTH_REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_REFRESH_TOKEN_EXPIRE_TIME=2592000

# CORS — the two frontends plus headroom for extra local ports.
ALLOW_ORIGINS=http://localhost:3900,http://localhost:3901,http://localhost:3902,http://localhost:3903,http://localhost:3904,http://localhost:3905
FRONTEND_URL=http://localhost:3902
