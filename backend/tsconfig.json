{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["es2021"],
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // No "noEmit" here. It was set, so `npm run build` — which is plain `tsc` — compiled
    // nothing: the build "succeeded", dist/ held no JavaScript, and `node dist/main.js`
    // would have died on a missing file. Nobody noticed locally because development runs
    // through ts-node. `npm run typecheck` passes --noEmit itself, which is where that
    // flag belongs.
    "outDir": "./dist",
    "baseUrl": "./"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
